.hero-ad-loop { min-height: 280px; }

@media (width >= 768px) {
  .hero-ad-loop { min-height: 436px; }
}

.hero-ad-loop { container-type: size; }

.hero-ad-loop__frame { max-width: 100%; height: 100%; aspect-ratio: var(--frame-w) / var(--frame-h); }

@supports (width:1cqw) {
  .hero-ad-loop__frame { max-width: none; height: auto; width: min(100cqw, calc(100cqh * var(--frame-w) / var(--frame-h)), calc(var(--frame-w) * 1px)); }
}

.hero-ad-loop__window { background: rgb(255, 255, 255); }

.hero-ad-loop__screen, .hero-ad-loop__card { opacity: 0; }

.hero-ad-loop__screen.is-entering, .hero-ad-loop__screen.is-leaving, .hero-ad-loop__card.is-entering, .hero-ad-loop__card.is-leaving { will-change: opacity, transform; }

.hero-ad-loop__screen.is-live, .hero-ad-loop__card.is-live, .hero-ad-loop__screen.is-leaving { opacity: 1; }

.hero-ad-loop__screen.is-entering { z-index: 1; animation: 0.52s cubic-bezier(0.16, 0.84, 0.32, 1) 0s 1 normal both running heroAdScreenIn; }

.hero-ad-loop__card.is-entering { z-index: 1; animation: 0.3s linear 0.23s 1 normal both running heroAdCardFadeIn, 0.52s cubic-bezier(0.16, 1, 0.3, 1) 0.23s 1 normal both running heroAdCardRise; }

.hero-ad-loop__card.is-leaving { animation: 0.2s linear 0s 1 normal both running heroAdCardFadeOut, 0.26s cubic-bezier(0.4, 0, 1, 1) 0s 1 normal both running heroAdCardSink; }

@keyframes heroAdScreenIn { 
  0% { opacity: 0; transform: scale(1.03); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes heroAdCardFadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes heroAdCardFadeOut { 
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes heroAdCardRise { 
  0% { transform: translateY(26px) scale(0.96); }
  100% { transform: translateY(0px) scale(1); }
}

@keyframes heroAdCardSink { 
  0% { transform: translateY(0px) scale(1); }
  100% { transform: translateY(14px) scale(0.985); }
}

.preview-section-frame { container-type: inline-size; }

@container (width <= 48rem) {
  .preview-section-frame-side { display: none; }
